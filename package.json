{
  "name": "gtnh-calc",
  "version": "1.0.0",
  "description": "GregTech: New Horizons calculator",
  "main": "index.js",
  "scripts": {
    "copy-files": "copyfiles -u 0 \"index.html\" \"assets/**/*\" \"data/**/*\" dist/",
    "start": "concurrently \"tsc --watch\" \"live-server --mount=/:./dist --mount=/data/:./data/ --mount=/assets/:./assets/ --port=3000\"",
    "build": "tsc && npm run copy-files",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:snapshot": "jest --updateSnapshot",
    "pretest": "tsc"
  },
  "keywords": [
    "gregtech",
    "minecraft",
    "calculator"
  ],
  "author": "ShadowTheAge",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "concurrently": "^8.2.2",
    "copyfiles": "^2.4.1",
    "javascript-lp-solver": "0.4.24",
    "jest": "^29.7.0",
    "live-server": "^1.2.2",
    "ts-jest": "^29.1.2",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "is-fullwidth-code-point": "^5.1.0"
  }
}
